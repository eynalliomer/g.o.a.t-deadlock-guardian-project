{
    "description": "Deadlock ve kurtarma: klasik deadlock oluşur, recovery en ucuz seçeneği uygular (P2 daha düşük öncelikli → R2 ondan geri alınır), sistem tekrar güvenli duruma döner ve processler işini bitirir.",
    "resources": [
        {"name": "R1", "total_instances": 1},
        {"name": "R2", "total_instances": 1}
    ],
    "processes": [
        {"name": "P1", "max": {"R1": 1, "R2": 1}, "priority": 2},
        {"name": "P2", "max": {"R1": 1, "R2": 1}, "priority": 1}
    ],
    "events": [
        {"action": "acquire", "process": "P1", "resource": "R1"},
        {"action": "acquire", "process": "P2", "resource": "R2"},
        {"action": "acquire", "process": "P1", "resource": "R2"},
        {"action": "acquire", "process": "P2", "resource": "R1"},
        {"action": "recover"},
        {"action": "release", "process": "P1", "resource": "R2"},
        {"action": "release", "process": "P1", "resource": "R1"},
        {"action": "acquire", "process": "P2", "resource": "R2"},
        {"action": "release", "process": "P2", "resource": "R1"},
        {"action": "release", "process": "P2", "resource": "R2"}
    ]
}
